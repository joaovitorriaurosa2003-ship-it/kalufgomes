<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Moreira & Filhos · Dashboard RH · Kaluf & Gomes</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800;900&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore-compat.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --gray:#4a4a4a;--gray-dark:#0f2138;--gray-mid:#6b6b6b;--gray-light:#f4f4f4;
  --navy:#0f2138;--navy-deep:#0a1826;
  --gold:#b8976a;--gold-dark:#9a7c57;--gold-light:#f7f0e6;--gold-pale:#faf6f0;
  --green:#3d9970;--red:#c0392b;--yellow:#e0a800;
  --white:#fff;--border:#e2ddd6;--text:#2e2e2e;--text-muted:#8a8078;
  --radius:10px;--shadow:0 2px 12px rgba(74,74,74,.08);
}
body{font-family:'Barlow',sans-serif;background:var(--gray-light);color:var(--text);display:flex;min-height:100vh}

/* SIDEBAR */
.sidebar{width:230px;flex-shrink:0;background:var(--gray-dark);display:flex;flex-direction:column;min-height:100vh}
.logo-wrap{padding:24px 20px 20px;border-bottom:1px solid rgba(255,255,255,.08);text-align:center}
.logo-signal{display:flex;align-items:center;justify-content:center;margin-bottom:12px}
.logo-o{width:100%;display:flex;align-items:center;justify-content:center}
.logo-o img{width:100%;max-width:190px;height:auto;display:block}
.logo-name{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:18px;color:#fff;letter-spacing:.03em;text-transform:uppercase;margin-top:10px}
.logo-sub{font-size:10px;font-weight:600;color:var(--gold);letter-spacing:.15em;text-transform:uppercase;margin-top:4px;opacity:.85}
.logo-tag{display:inline-block;border:1px solid rgba(184,151,106,.3);border-radius:4px;color:rgba(255,255,255,.4);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:3px 10px;margin-top:8px}
.nav-section{font-size:9px;font-weight:700;color:rgba(255,255,255,.25);text-transform:uppercase;letter-spacing:.12em;padding:20px 20px 6px}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 20px;cursor:pointer;font-size:13px;font-weight:600;color:rgba(255,255,255,.5);border-left:3px solid transparent;transition:all .15s}
.nav-item:hover{background:rgba(255,255,255,.06);color:#fff}
.nav-item.active{background:rgba(184,151,106,.12);color:#fff;border-left-color:var(--gold)}
.nav-item i{font-size:17px;flex-shrink:0}
.sidebar-footer{padding:14px 20px;border-top:1px solid rgba(255,255,255,.08);font-size:11px;font-weight:600;color:rgba(255,255,255,.2);margin-top:auto}

/* MAIN */
.main{flex:1;display:flex;flex-direction:column;min-width:0}
.topbar{background:var(--white);border-bottom:1px solid var(--border);padding:14px 24px;display:flex;align-items:center;justify-content:space-between}
.topbar-left h2{font-family:'Barlow Condensed',sans-serif;font-size:20px;font-weight:800;color:var(--text);text-transform:uppercase;letter-spacing:.04em}
.topbar-left p{font-size:12px;font-weight:500;color:var(--text-muted);margin-top:1px}
.topbar-right{display:flex;align-items:center;gap:10px}
.topbar-badge{background:var(--gold-pale);color:var(--gold-dark);font-size:12px;font-weight:700;padding:6px 14px;border-radius:6px;display:flex;align-items:center;gap:6px;border:1px solid rgba(184,151,106,.25)}
.topbar-year{display:flex;gap:4px}
.yr-btn{padding:5px 12px;border-radius:6px;border:1.5px solid var(--border);background:var(--white);font-size:12px;font-weight:700;color:var(--text-muted);cursor:pointer;font-family:'Barlow',sans-serif;transition:all .15s}
.yr-btn:hover{border-color:var(--gold);color:var(--gold-dark)}
.yr-btn.active{background:var(--gray-dark);color:#fff;border-color:var(--gray-dark)}
.content{padding:20px;flex:1;overflow-y:auto}
.page{display:none;flex-direction:column;gap:16px}
.page.active{display:flex}

/* KPI */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
.kpi{background:var(--white);border-radius:var(--radius);border:1px solid var(--border);padding:16px 18px;position:relative;overflow:hidden;box-shadow:var(--shadow)}
.kpi::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:var(--gold)}
.kpi.kpi-green::after{background:var(--green)}.kpi.kpi-red::after{background:var(--red)}.kpi.kpi-yellow::after{background:var(--yellow)}
.kpi-icon{width:36px;height:36px;border-radius:8px;background:var(--gold-pale);display:flex;align-items:center;justify-content:center;margin-bottom:10px;font-size:18px;color:var(--gold-dark);border:1px solid rgba(184,151,106,.2)}
.kpi label{font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em}
.kpi-val{font-size:24px;font-weight:900;color:var(--text);margin-top:3px;line-height:1;font-family:'Barlow Condensed',sans-serif}
.kpi-sub{font-size:11px;font-weight:600;color:var(--text-muted);margin-top:5px;display:flex;align-items:center;gap:4px}
.trend-up{color:var(--green);font-weight:800}.trend-down{color:var(--red);font-weight:800}

/* CARDS */
.row2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}
.card{background:var(--white);border-radius:var(--radius);border:1px solid var(--border);padding:18px 20px;box-shadow:var(--shadow)}
.card.full{grid-column:1/-1}
.card-title{font-family:'Barlow Condensed',sans-serif;font-size:15px;font-weight:800;color:var(--text);margin-bottom:3px;display:flex;align-items:center;gap:8px;text-transform:uppercase;letter-spacing:.04em}
.card-title i{font-size:17px;color:var(--gold)}
.card-sub{font-size:11px;font-weight:500;color:var(--text-muted);margin-bottom:14px}

/* BK CARDS */
.bk-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
.bk-card{background:var(--white);border-radius:var(--radius);border:1px solid var(--border);padding:14px 16px 14px 20px;position:relative;overflow:hidden;box-shadow:var(--shadow)}
.bk-card .accent{position:absolute;left:0;top:0;bottom:0;width:4px}
.bk-card.ok .accent{background:var(--green)}.bk-card.warn .accent{background:var(--yellow)}.bk-card.crit .accent{background:var(--red)}
.bk-icon{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:8px;font-size:17px}
.bk-icon.ok{background:#e8f5ee;color:#2d7a55}.bk-icon.warn{background:#fff8e0;color:#b07800}.bk-icon.crit{background:#fdecea;color:#a33}
.bk-lbl{font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px}
.bk-val{font-size:22px;font-weight:900;color:var(--text);line-height:1;font-family:'Barlow Condensed',sans-serif}
.bk-meta{font-size:11px;font-weight:500;color:var(--text-muted);margin-top:3px}
.badge{display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;padding:3px 8px;border-radius:20px;margin-top:6px}
.badge.ok{background:#e8f5ee;color:#2d7a55}.badge.warn{background:#fff8e0;color:#b07800}.badge.crit{background:#fdecea;color:#a33}

/* PILL */
.pill-bar{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.pill{display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;transition:all .15s;border:1.5px solid var(--border);background:var(--white);color:var(--text-muted);font-family:'Barlow',sans-serif}
.pill:hover{border-color:var(--gold);color:var(--gold-dark)}
.pill.active{background:var(--gray-dark);color:#fff;border-color:var(--gray-dark)}
.pill i{font-size:14px}

/* SUMMARY */
.summary-list{display:flex;flex-direction:column;gap:6px}
.summary-row{display:flex;align-items:center;gap:10px;padding:9px 14px;border-radius:8px;background:var(--gold-pale);border:1px solid rgba(184,151,106,.2)}
.s-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.s-lbl{font-size:12px;font-weight:700;color:var(--text);flex:1}
.s-val{font-size:13px;font-weight:900;color:var(--text);font-family:'Barlow Condensed',sans-serif}
.s-meta{font-size:10px;font-weight:500;color:var(--text-muted);margin-left:2px}

/* PROG */
.prog-item{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.prog-lbl{font-size:12px;font-weight:700;color:var(--text-muted);width:140px;flex-shrink:0}
.prog-track{flex:1;background:#ede8e0;border-radius:4px;height:9px}
.prog-fill{height:9px;border-radius:4px}
.prog-val{font-size:12px;font-weight:800;color:var(--text);width:50px;text-align:right}

/* TABELA */
.rh-table{width:100%;border-collapse:collapse}
.rh-table th{font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;padding:7px 10px;border-bottom:2px solid var(--border);text-align:left;white-space:nowrap}
.rh-table td{font-size:13px;font-weight:600;color:var(--text);padding:9px 10px;border-bottom:1px solid var(--border)}
.rh-table tr:last-child td{border-bottom:none}
.rh-table tr:hover td{background:var(--gold-pale)}
.tag-status{display:inline-flex;align-items:center;gap:3px;padding:3px 9px;border-radius:20px;font-size:10px;font-weight:700}
.tag-ok{background:#e8f5ee;color:#2d7a55}.tag-warn{background:#fff8e0;color:#b07800}.tag-crit{background:#fdecea;color:#a33}

/* SIMULADOR */
.sim-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:16px}
.sim-field{display:flex;flex-direction:column;gap:4px}
.sim-field label{font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em}
.sim-field input,.sim-field select{padding:9px 12px;border:1.5px solid var(--border);border-radius:6px;font-size:14px;font-weight:700;color:var(--text);background:var(--white);font-family:'Barlow',sans-serif;outline:none;transition:border .15s}
.sim-field input:focus,.sim-field select:focus{border-color:var(--gold)}
.res-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:4px}
.res-card{border-radius:8px;padding:12px 14px;border:1px solid var(--border)}
.res-card.hi{background:var(--gold-pale);border-color:rgba(184,151,106,.35)}
.res-card.danger{background:#fdecea;border-color:rgba(192,57,43,.25)}
.res-lbl{font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px}
.res-val{font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:900;color:var(--text)}
.res-val.green{color:var(--green)}.res-val.red{color:var(--red)}
.sec-label{font-size:10px;font-weight:800;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin:10px 0 6px;padding-top:8px;border-top:1px solid var(--border)}

::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}

/* LOGIN GATE */
#login-gate{position:fixed;inset:0;background:var(--navy-deep);display:flex;align-items:center;justify-content:center;z-index:999;flex-direction:column}
#login-gate.hidden{display:none}
.login-card{background:var(--white);border-radius:14px;padding:36px 34px;width:100%;max-width:320px;box-shadow:0 10px 40px rgba(0,0,0,.35)}
.login-title{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:20px;color:var(--navy);text-align:center;text-transform:uppercase;letter-spacing:.04em;margin-bottom:2px}
.login-sub{font-size:12px;color:var(--text-muted);text-align:center;margin-bottom:22px}
.login-field{margin-bottom:14px}
.login-field label{font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;display:block;margin-bottom:5px}
.login-field input{width:100%;padding:11px 13px;border:1.5px solid var(--border);border-radius:8px;font-size:14px;font-family:'Barlow',sans-serif;outline:none}
.login-field input:focus{border-color:var(--gold)}
.login-btn{width:100%;padding:12px;border:none;border-radius:8px;background:var(--navy);color:#fff;font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:.05em;cursor:pointer;margin-top:6px;font-family:'Barlow',sans-serif}
.login-btn:hover{background:var(--navy-deep)}
.login-btn:disabled{opacity:.6;cursor:default}
.login-error{color:var(--red);font-size:12px;text-align:center;margin-top:10px;min-height:16px}
.login-brand{color:rgba(255,255,255,.35);font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;margin-top:18px}
#app-root{display:none}
#app-root.visible{display:flex}
#dash-loading{position:fixed;inset:0;background:var(--navy-deep);display:none;align-items:center;justify-content:center;color:#fff;font-family:'Barlow',sans-serif;font-size:13px;z-index:998}
#dash-loading.visible{display:flex}
</style>
</head>
<body>

<!-- LOGIN GATE -->
<div id="login-gate">
  <div class="login-card">
    <div class="login-title">Moreira & Filhos</div>
    <div class="login-sub">Dashboard de RH · acesso restrito</div>
    <div class="login-field">
      <label>Senha de acesso</label>
      <input type="password" id="login-senha" placeholder="••••••••" onkeydown="if(event.key==='Enter')fazerLogin()">
    </div>
    <button class="login-btn" id="login-btn" onclick="fazerLogin()">Entrar</button>
    <div class="login-error" id="login-error"></div>
  </div>
  <div class="login-brand">Kaluf &amp; Gomes</div>
</div>

<!-- LOADING -->
<div id="dash-loading">Carregando dados...</div>

<div id="app-root">
<!-- SIDEBAR -->
<nav class="sidebar">
  <div class="logo-wrap">
    <div class="logo-signal">
      <div class="logo-o">
        <img src="data:image/png;base64," alt="Kaluf & Gomes Soluções Empresariais">
      </div>
    </div>
    <div><span class="logo-tag">RH · Dashboard</span></div>
  </div>
  <div class="nav-section">Recursos Humanos</div>
  <div class="nav-item active" id="nav-abs" onclick="setPage('abs')"><i class="ti ti-activity"></i>Absenteísmo & Turnover</div>
  <div class="nav-item" id="nav-custo" onclick="setPage('custo')"><i class="ti ti-coin"></i>Custo de Pessoal</div>
  <div class="nav-item" id="nav-movim" onclick="setPage('movim')"><i class="ti ti-arrows-exchange"></i>Rescisões & Admissões</div>
  <div class="nav-item" id="nav-sim" onclick="setPage('sim')"><i class="ti ti-calculator"></i>Simulador de Rescisão</div>
  <div class="sidebar-footer">Kaluf & Gomes &nbsp;·&nbsp; 2026</div>
</nav>

<!-- MAIN -->
<div class="main">
  <div class="topbar">
    <div class="topbar-left">
      <h2 id="page-title">Absenteísmo & Turnover</h2>
      <p id="page-sub">KPIs mensais · Moreira & Filhos</p>
    </div>
    <div class="topbar-right">
      <div class="topbar-year">
        <button class="yr-btn" onclick="setYear('2024',this)">2024</button>
        <button class="yr-btn" onclick="setYear('2025',this)">2025</button>
        <button class="yr-btn active" onclick="setYear('2026',this)">2026</button>
      </div>
      <div class="topbar-badge"><i class="ti ti-calendar"></i><span id="topbar-date"></span></div>
    </div>
  </div>

  <div class="content">

    <!-- ══ ABS & TURNOVER ══ -->
    <div class="page active" id="page-abs">
      <div class="kpi-grid" id="kpi-abs"></div>
      <div class="row2">
        <div class="card">
          <div class="card-title"><i class="ti ti-activity"></i>Absenteísmo (%)</div>
          <div class="card-sub">Evolução mensal — meta: ≤ 3%</div>
          <div style="position:relative;width:100%;height:200px"><canvas id="ch-abs"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title"><i class="ti ti-refresh"></i>Turnover (%)</div>
          <div class="card-sub">Evolução mensal — meta: ≤ 5%</div>
          <div style="position:relative;width:100%;height:200px"><canvas id="ch-turn"></canvas></div>
        </div>
      </div>
      <div class="row2">
        <div class="card">
          <div class="card-title"><i class="ti ti-chart-bar"></i>Motivos de Ausência</div>
          <div class="card-sub">Distribuição por tipo — período selecionado</div>
          <div style="position:relative;width:100%;height:200px"><canvas id="ch-motivos"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title"><i class="ti ti-users"></i>Absenteísmo por Área</div>
          <div class="card-sub">Percentual médio por departamento</div>
          <div style="position:relative;width:100%;height:200px"><canvas id="ch-area-abs"></canvas></div>
        </div>
      </div>
    </div>

    <!-- ══ CUSTO DE PESSOAL ══ -->
    <div class="page" id="page-custo">
      <div class="kpi-grid" id="kpi-custo"></div>
      <div class="row2">
        <div class="card">
          <div class="card-title"><i class="ti ti-trending-up"></i>Folha Mensal (R$)</div>
          <div class="card-sub">Evolução da folha bruta de pagamento</div>
          <div style="position:relative;width:100%;height:210px"><canvas id="ch-folha"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title"><i class="ti ti-chart-donut-3"></i>Composição do Custo</div>
          <div class="card-sub">Breakdown por encargo — período selecionado</div>
          <div style="position:relative;width:100%;height:210px"><canvas id="ch-encargos"></canvas></div>
        </div>
      </div>
      <div class="card full">
        <div class="card-title"><i class="ti ti-building"></i>Custo por Departamento</div>
        <div class="card-sub">Folha bruta e headcount por área</div>
        <div id="custo-dept"></div>
      </div>
    </div>

    <!-- ══ RESCISÕES & ADMISSÕES ══ -->
    <div class="page" id="page-movim">
      <div class="bk-grid" id="kpi-movim-top"></div>
      <div class="row2">
        <div class="card">
          <div class="card-title"><i class="ti ti-arrows-exchange"></i>Admissões vs Rescisões</div>
          <div class="card-sub">Movimentação mensal de pessoal</div>
          <div style="position:relative;width:100%;height:210px"><canvas id="ch-movim"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title"><i class="ti ti-chart-pie"></i>Motivos de Desligamento</div>
          <div class="card-sub">Distribuição por tipo de saída</div>
          <div style="position:relative;width:100%;height:210px"><canvas id="ch-motivos-desl"></canvas></div>
        </div>
      </div>
      <div class="card full">
        <div class="card-title"><i class="ti ti-list"></i>Histórico de Movimentações</div>
        <div class="card-sub">Últimas admissões e rescisões — dados fictícios</div>
        <table class="rh-table" id="tabela-movim"></table>
      </div>
    </div>

    <!-- ══ SIMULADOR DE RESCISÃO ══ -->
    <div class="page" id="page-sim">
      <div class="card full">
        <div class="card-title"><i class="ti ti-file-invoice"></i>Simulador de Rescisão — Contrato de Experiência</div>
        <div class="card-sub">Pedido de demissão · Cálculos automáticos com base na tabela progressiva INSS 2025</div>
        <div class="sim-grid">
          <div class="sim-field">
            <label>Salário Base (R$)</label>
            <input type="number" id="sal" value="3200" step="100" oninput="calcResc()">
          </div>
          <div class="sim-field">
            <label>Duração do Contrato</label>
            <select id="duracao" onchange="calcResc()">
              <option value="45">45 dias</option>
              <option value="90">90 dias</option>
            </select>
          </div>
          <div class="sim-field">
            <label>Tipo de Desligamento</label>
            <select id="tipo-desl" onchange="calcResc()">
              <option value="pedido">Pedido de demissão</option>
              <option value="semjusta">Dispensa sem justa causa</option>
              <option value="comjusta">Dispensa com justa causa</option>
              <option value="acordo">Acordo mútuo (§6º)</option>
            </select>
          </div>
          <div class="sim-field">
            <label>Meses trabalhados</label>
            <input type="number" id="meses-trab" value="3" min="1" max="12" step="1" oninput="calcResc()">
          </div>
          <div class="sim-field">
            <label>Dependentes</label>
            <input type="number" id="deps" value="0" min="0" max="10" step="1" oninput="calcResc()">
          </div>
          <div class="sim-field">
            <label>Vale Transporte/mês (R$)</label>
            <input type="number" id="vt" value="220" step="10" oninput="calcResc()">
          </div>
        </div>
        <div id="resc-output"></div>
      </div>
    </div>

  </div>
</div>
</div><!-- /app-root -->

