        <div class="sec-label"><i class="ti ti-building" style="margin-right:4px"></i>Custo Total Empregador</div>
        <div style="display:flex;flex-direction:column;gap:5px">
          ${row('Verbas brutas pagas',bruto)}
          ${row('INSS patronal (20%)',inssPat)}
          ${row('FGTS (8% sobre verbas)',fgts)}
          ${fgtsMulPago?row('Multa FGTS (emp. paga)',fgtsMulPago):''}
          ${row('RAT + Terceiros (~3,8%)',ratTerceiros)}
          <div style="height:4px"></div>
          ${rowTotal('Custo total empregador',custoTotal,RED)}
        </div>
        <div style="margin-top:14px;padding:10px 14px;background:var(--gold-pale);border-radius:8px;border:1px solid rgba(184,151,106,.3)">
          <div style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">Tipo de desligamento</div>
          <div style="font-size:13px;font-weight:700;color:var(--text)">${nomeTipo[tipo]}</div>
          <div style="font-size:11px;font-weight:500;color:var(--text-muted);margin-top:2px">Salário: ${brl(sal)} · Contrato: ${dias} dias · ${meses} mes(es)</div>
        </div>
      </div>
    </div>`;
}

/* ══ NAV & YEAR ══ */
let rendered={abs:true,custo:false,movim:false,sim:false};

function setPage(p){
  ['abs','custo','movim','sim'].forEach(x=>{
    document.getElementById('page-'+x).classList.toggle('active',x===p);
    document.getElementById('nav-'+x).classList.toggle('active',x===p);
  });
  document.getElementById('page-title').textContent=PAGE_TITLES[p];
  document.getElementById('page-sub').textContent=PAGE_SUBS[p];
  if(p==='custo'&&!rendered.custo){renderCusto();rendered.custo=true;}
  if(p==='movim'&&!rendered.movim){renderMovim();rendered.movim=true;}
  if(p==='sim'&&!rendered.sim){calcResc();rendered.sim=true;}
}

function setYear(y,el){
  ANO=y;
  document.querySelectorAll('.yr-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
  rendered={abs:false,custo:false,movim:false,sim:false};
  const active=document.querySelector('.page.active').id.replace('page-','');
  if(active==='abs'){renderAbs();rendered.abs=true;}
  else if(active==='custo'){renderCusto();rendered.custo=true;}
  else if(active==='movim'){renderMovim();rendered.movim=true;}
}

/* INIT: renderAbs() agora é chamado dentro de auth.onAuthStateChanged, após o login e o carregamento dos dados do Firestore. */
</script>
