/* ══ SIMULADOR ══ */
function calcINSS(sal){
  const tab=[[1518.00,.075],[2793.88,.09],[4190.83,.12],[8157.41,.14]];
  let inss=0,ant=0;
  for(const[teto,aliq]of tab){
    if(sal<=ant)break;
    inss+=( Math.min(sal,teto)-ant )*aliq;
    ant=teto;
  }
  return inss;
}
function calcIRRF(base){
  const tab=[[2259.20,0,0],[2826.65,.075,169.44],[3751.05,.15,381.44],[4664.68,.225,662.77],[Infinity,.275,896.00]];
  for(const[lim,aliq,ded]of tab){if(base<=lim)return Math.max(0,base*aliq-ded);}
  return 0;
}
